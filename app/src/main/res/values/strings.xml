    <!-- Cookie Guide Dialog -->
    <string name="btn_cookie_guide">How to get Cookie manually?</string>
    <string name="cookie_guide_title">How to Get Cookie Manually</string>
    <string name="cookie_guide_content">1. Open hoyolab.com (or miyoushe.com) in your desktop browser and log in.\n\n2. Press F12 (Developer Tools) -> Application -> Storage -> Cookies.\n\n3. Copy the values of \'ltuid_v2\' (or \'ltuid\') and \'ltoken_v2\' (or \'ltoken\').\n\n4. Format: ltuid_v2=XXXX; ltoken_v2=YYYY;\n\n5. In HoYoLAB / Miyoushe Privacy Settings, make sure \'Real-Time Notes\' is enabled as Public for your account.</string>
    <string name="dialog_close">Got it</string>

